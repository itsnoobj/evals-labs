{
  "name": "evals-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evals Lab: a browser page that teaches how to evaluate an AI agent, using a small model that runs in your browser.",
  "homepage": "https://itsnoobj.github.io/evals-labs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsnoobj/evals-labs.git"
  },
  "bugs": {
    "url": "https://github.com/itsnoobj/evals-labs/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "node scripts/check-syntax.mjs",
    "benchmark:audit": "node scripts/audit-key.mjs",
    "benchmark:ask-help": "node scripts/ask-help-experiment.mjs",
    "benchmark:ask-help-guarded": "node scripts/ask-help-guarded.mjs",
    "benchmark:judge-calibration": "node scripts/judge-calibration.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
